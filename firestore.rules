rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Archbro project state is server-governed. Browser/WebMCP clients go
    // through FastAPI, Firebase ID-token verification, and ProjectAuthorizer.
    // Firebase Admin SDK calls from the Cloud Run service account are governed
    // by IAM and are not blocked by these client security rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
